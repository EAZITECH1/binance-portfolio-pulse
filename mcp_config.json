{
  "$schema": "https://json.schemastore.org/mcp-config.json",
  "mcpServers": {
    "binance-portfoliopulse": {
      "command": "python3",
      "args": ["-m", "src.connectors.mcp_client", "--stdio"],
      "env": {
        "PYTHONPATH": "."
      }
    },
    "binance-official-hosted": {
      "url": "https://agent.binance.com/mcp/agentic",
      "description": "Direct official Binance Agent OS hosted streamable HTTP endpoint"
    }
  }
}
