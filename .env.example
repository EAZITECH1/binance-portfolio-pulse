# ==============================================================================
# Binance PortfolioPulse AI - Environment Configuration
# ==============================================================================

# Operation Mode: 'api' (default, real live Binance market data), 'mcp' (Binance Agent OS MCP)
AGENT_MODE=api

# ------------------------------------------------------------------------------
# 1. Binance Agent OS - MCP Server Configuration
# ------------------------------------------------------------------------------
# Official hosted Binance Agent OS MCP Server endpoint
BINANCE_MCP_ENDPOINT=https://agent.binance.com/mcp/agentic
# Optional bearer / session token if required by custom MCP transport
BINANCE_MCP_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 2. Binance Exchange API (For Direct REST / Fallback Mode)
# ------------------------------------------------------------------------------
# Read-only Spot API Key and Secret (Agentic Sub-account or Main Account)
# DO NOT enable withdrawal permissions! Only 'Read Info' or 'Enable Reading' required.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com

# ------------------------------------------------------------------------------
# 3. LLM Model & Key Configuration (Optional)
# ------------------------------------------------------------------------------
# The agent includes a built-in financial reasoning engine that works 100% offline
# without any external keys. If you want to use an external LLM for standalone
# conversational synthesis and tweet drafting outside Claude Desktop, simply
# plug in your preferred model and API key:
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your-model-name-here
# Optional custom base URL if using a proxy or custom provider endpoint:
# LLM_BASE_URL=https://api.your-provider.com/v1

# ------------------------------------------------------------------------------
# 4. Report & Risk Thresholds
# ------------------------------------------------------------------------------
# Alert if a single asset exceeds this fraction of total portfolio (e.g. 0.35 = 35%)
RISK_CONCENTRATION_THRESHOLD=0.35

# Alert if an asset's 24h absolute price move exceeds this fraction (e.g. 0.08 = 8%)
RISK_VOLATILITY_THRESHOLD=0.08

# Minimum recommended stablecoin / cash reserve fraction (e.g. 0.10 = 10%)
MIN_STABLECOIN_BUFFER=0.10

# Output directory for generated reports
REPORTS_OUTPUT_DIR=reports
